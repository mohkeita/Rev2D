{
  "format": "rev2d",
  "version": 1,
  "meta": {
    "name": "slime",
    "width": 400,
    "height": 400,
    "background": "#232c42",
    "fps": 30,
    "author": "Rev2D examples",
    "description": "Squash & stretch mascot: warp keyforms for Squash/Lean, bone lift for Jump, add/multiply blending, ellipse-ry blink, mouth path morph, \"takeoff\"/\"land\" events."
  },
  "parameters": [
    {
      "id": "Squash",
      "min": -1,
      "max": 1,
      "default": 0,
      "group": "Body",
      "description": "+1 squashed flat and wide, -1 stretched tall and thin."
    },
    {
      "id": "Lean",
      "min": -1,
      "max": 1,
      "default": 0,
      "group": "Body",
      "description": "Top of the body leans left (-1) / right (+1)."
    },
    {
      "id": "Jump",
      "min": 0,
      "max": 1,
      "default": 0,
      "group": "Body",
      "description": "Height above the ground: 0 grounded, 1 = 140 px up."
    },
    {
      "id": "EyeOpen",
      "min": 0,
      "max": 1,
      "default": 1,
      "group": "Face",
      "description": "Both eyes: 0 closed (ellipse ry shrinks), 1 open."
    },
    {
      "id": "MouthOpen",
      "min": 0,
      "max": 1,
      "default": 0,
      "group": "Face",
      "description": "0 small smile, 1 open \"wheee\"."
    },
    {
      "id": "Glow",
      "min": 0,
      "max": 1,
      "default": 0.4,
      "group": "Effects",
      "description": "Inner glow and sparkles (additive blending)."
    }
