      "events": [{ "time": 0.25, "name": "step", "int": 3 }, { "time": 0.75, "name": "sound" }],
      "ik": {
        "arm-ik": [
          { "softness": 4, "bendPositive": false, "stretch": true, "curve": [0.25, 1, 0.75, 0, 0.25, 4, 0.75, 4] },
