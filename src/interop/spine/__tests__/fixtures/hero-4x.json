    "soft": {
      "ik": {
        "arm-ik": [
          { "softness": 4, "bendPositive": false, "stretch": true },
          { "time": 1, "softness": 20, "bendPositive": false, "stretch": true },
          { "time": 2, "softness": 4, "bendPositive": true, "stretch": true }
        ]
      }
