    { "name": "sheared", "parent": "root", "x": -20, "shearX": 10 },
    { "name": "tip", "parent": "head", "x": 30, "inherit": "noRotationOrReflection" },
    { "name": "back-shoulder", "parent": "torso", "x": 30, "y": -10 },
